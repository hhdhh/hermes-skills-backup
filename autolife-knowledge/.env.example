# Autolife knowledge base configuration.
# Copy to .env and edit; the skill loads .env automatically.
# Values already present in the environment always win over this file.
#
# EASIEST PATH: run `python scripts/setup.py` and paste the API key when asked.
# It fills in KB_PUBLIC_URL + KB_API_TOKEN and verifies them against the
# live gateway. Everything below the "public mode" section then becomes
# optional, and no NetBird tunnel is needed.

# ---------------------------------------------------------------------------
# Public mode (recommended) - internet-facing gateway, API key auth
# ---------------------------------------------------------------------------
# Setting KB_API_TOKEN switches the skill to public mode automatically:
# no VPN, no AstrBot account. Get the key from your admin.
KB_PUBLIC_URL=https://fae.gz.autolife.ai:8866/kb
KB_API_TOKEN=

# ---------------------------------------------------------------------------
# Internal mode - only used when KB_API_TOKEN is empty (or --internal is passed)
# ---------------------------------------------------------------------------
# AstrBot Dashboard API. NOTE: the server currently serves plain HTTP only,
# so credentials and the JWT are not encrypted in transit (inside NetBird).
KB_BASE_URL=http://100.98.150.220:6185

# Built-in FAE account. Override with a personal account if you have one.
KB_USERNAME=autolife
KB_PASSWORD=123455

# Comma-separated list. autolife知识库 is the main corpus; autolife-docs holds
# a few overlapping copies. Order is preserved and duplicates are dropped.
KB_NAMES=autolife知识库,autolife-docs

# Maximum chunks kept per document after de-duplication (0 = unlimited).
KB_MAX_PER_DOC=2

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# Number of chunks returned (server caps at 20).
KB_TOP_K=5

# Character cap for text output (0 = unlimited).
KB_MAX_CHARS=12000

# HTTP timeout in seconds, and how long to wait for background indexing.
KB_TIMEOUT=30
KB_UPLOAD_TIMEOUT=900

# Reuse the JWT between runs (valid ~7 days). Set to 0 to log in every call.
KB_CACHE_TOKEN=1

# Set to 1 to silence the plaintext-HTTP warning.
KB_SUPPRESS_HTTP_WARNING=0

# Only this self-hosted NetBird management server is accepted (internal mode).
NETBIRD_MANAGEMENT_URL=https://netbird.autolife-robotics.com:443

